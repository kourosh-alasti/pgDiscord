{
  "name": "pgdiscord",
  "version": "0.1.1",
  "description": "Discord bot providing safe read-only PostgreSQL access for AI agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "register-commands": "tsx src/register-commands.ts",
    "test": "tsx scripts/test-query-filter.ts"
  },
  "keywords": [
    "discord",
    "postgresql",
    "database",
    "read-only",
    "ai-agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pgsql-ast-parser": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
