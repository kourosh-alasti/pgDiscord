# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token

# PostgreSQL connection string — passed at startup, never exposed in Discord
# Can also be passed via --database-url CLI flag
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Inactivity timeout in minutes before disconnecting (default: 30)
INACTIVITY_TIMEOUT_MINUTES=30

# Optional: restrict bot to specific guild for faster command registration during dev
DISCORD_GUILD_ID=
